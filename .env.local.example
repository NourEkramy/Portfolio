# Copy this file to .env.local and fill it in.
# The public site works without any of these — it falls back to the content
# committed in src/content. Supabase is what turns the dashboard on.

# Supabase → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Settings → API → Project API keys → anon / public
# Safe to expose; row level security is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Storage bucket for screenshots, demo videos and the CV.
NEXT_PUBLIC_SUPABASE_BUCKET=portfolio-media

# Supabase → Settings → API → Project API keys → service_role
# SERVER ONLY. Bypasses row level security — never commit it and never prefix
# it with NEXT_PUBLIC_. Used solely by `npm run upload:media`.
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL. Lets `npm run db:setup` apply schema.sql and seed.sql for you
# instead of pasting them into the SQL editor.
# Settings -> Database -> Connection string -> URI, session pooler (port 5432).
# Contains your database password, so it stays in this file only.
DATABASE_URL=

# The deployed origin, used for absolute URLs in metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
